{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cooperativ-labs/overlord-marketplace/schemas/lock.schema.json",
  "title": "Overlord marketplace source lock",
  "description": "What ingest fetched for one plugin. Lives at sources/<plugin>.lock.json and is written only by scripts/ingest.mjs. Digest encodings are defined in docs/contracts.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockVersion", "plugin", "version", "sourceSha256", "indexSha256", "fetchedAt", "hosts"],
  "properties": {
    "lockVersion": { "const": 1 },
    "plugin": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "version": {
      "description": "Strict SemVer 2.0.0 shared by the index and both host manifests.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$"
    },
    "releaseId": {
      "description": "Upstream release/source identifier when the index advertises one.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:+-]+$"
    },
    "sourceSha256": { "$ref": "#/$defs/sha256" },
    "indexSha256": { "$ref": "#/$defs/sha256" },
    "fetchedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude-code"],
      "properties": {
        "codex": { "$ref": "#/$defs/hostLock" },
        "claude-code": { "$ref": "#/$defs/hostLock" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hostLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "zipSha256", "treeSha256", "fileCount"],
      "properties": {
        "url": { "type": "string", "maxLength": 512, "pattern": "^https://[a-z0-9.-]+(/[A-Za-z0-9._~-]+)+$" },
        "zipSha256": { "$ref": "#/$defs/sha256" },
        "advertisedSha256": {
          "description": "Checksum the index advertised for this artifact, when present. Must equal zipSha256.",
          "$ref": "#/$defs/sha256"
        },
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 5000 }
      }
    }
  }
}
