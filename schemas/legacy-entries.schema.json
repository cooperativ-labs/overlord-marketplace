{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cooperativ-labs/overlord-marketplace/schemas/legacy-entries.schema.json",
  "title": "Overlord marketplace legacy catalog entries",
  "description": "Catalog entries that predate source-owned ingest, or are owned elsewhere. Each listed entry must stay present and byte-for-value identical in its catalog until a separately scoped change retires it. See docs/contracts.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "entries"],
  "properties": {
    "$schema": { "const": "../schemas/legacy-entries.schema.json" },
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "reason", "entry"],
        "properties": {
          "host": { "enum": ["codex", "claude-code"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "entry": {
            "type": "object",
            "required": ["name", "source"],
            "properties": {
              "name": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" }
            }
          }
        }
      }
    }
  }
}
